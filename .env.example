# Copy to .env (gitignored) and fill in. Never commit .env.

# GitHub PAT used by Backstage: read catalog files, create repos, open PRs (classic: repo + workflow).
GITHUB_TOKEN=

# GitHub OAuth app: homepage http://localhost:3000,
# callback http://localhost:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Local PostgreSQL (docker-compose.yaml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=

# Written by scripts/cluster-tokens.sh from platform-infra (read-only credentials).
K8S_CLUSTER_URL=
K8S_SA_TOKEN=
ARGOCD_AUTH_TOKEN=
# Random token for local API checks (app-config.local.yaml, gitignored).
BACKSTAGE_TEST_TOKEN=
